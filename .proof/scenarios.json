{
  "repository": "brunnojob/android-offshore-field-console",
  "inputs": [
    ".proof/scenarios.json",
    ".proof/junit.py"
  ],
  "cases": [
    {
      "name": "sdkmanager \"platforms;android-37.2\"",
      "argv": [
        "bash",
        "-e",
